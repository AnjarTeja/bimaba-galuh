generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RegistrationStatus {
  submitted
  awaiting_payment
  awaiting_verification
  under_review
  follow_up_required
  confirmed
  rejected
  withdrawn
  expired
}

enum PaymentStatus {
  pending
  proof_submitted
  processing
  verified
  rejected
  expired
  refunded
}

enum StudentStatus {
  active
  graduated
  withdrawn
  inactive
}

enum ConsentType {
  registration_processing
  contact
  media_publication
  other
}

enum PublicationStatus {
  draft
  pending_review
  published
  rejected
  archived
}

enum InvoiceStatus {
  unpaid
  partially_paid
  paid
  overdue
  cancelled
}

enum MessageStatus {
  new
  in_progress
  resolved
  archived
}

enum IdempotencyStatus {
  in_progress
  completed
}

model Branch {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(191)
  name        String   @db.VarChar(191)
  area        String   @db.VarChar(191)
  address     String?  @db.Text
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  phone       String?  @db.VarChar(32)
  hours       Json?
  facilities  String?  @db.Text
  description String?  @db.Text
  active      Boolean  @default(true)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  registrations   Registration[]
  students        Student[]
  staffMembers    StaffMember[]
  events          Event[]
  messages        Message[]
  userBranchRoles UserBranchRole[]
  activityLogs    ActivityLog[]

  @@map("branches")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(191)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  branchRoles          UserBranchRole[]
  changedStatusHistory RegistrationStatusHistory[] @relation("RegistrationStatusChangedBy")
  verifiedTransactions PaymentTransaction[]        @relation("PaymentVerifiedBy")
  reviewedProofs       PaymentProof[]              @relation("PaymentProofReviewedBy")
  uploadedAssets       MediaAsset[]                @relation("MediaAssetUploadedBy")
  createdEvents        Event[]                     @relation("EventCreatedBy")
  handledMessages      Message[]                   @relation("MessageHandledBy")
  recordedSppPayments  SppPayment[]                @relation("SppPaymentRecordedBy")
  recordedUniforms     UniformDelivery[]           @relation("UniformRecordedBy")
  activityLogs         ActivityLog[]               @relation("ActivityLogActor")
  updatedSettings      AppSetting[]                @relation("AppSettingUpdatedBy")
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(191)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  userBranchRoles UserBranchRole[]

  @@map("roles")
}

model UserBranchRole {
  id       String  @id @default(uuid()) @db.Char(36)
  userId   String  @map("user_id") @db.Char(36)
  roleId   String  @map("role_id") @db.Char(36)
  branchId String? @map("branch_id") @db.Char(36)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, roleId, branchId])
  @@index([branchId, roleId])
  @@map("user_branch_roles")
}

model Guardian {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(191)
  phoneE164 String   @unique @map("phone_e164") @db.VarChar(32)
  email     String?  @db.VarChar(191)
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrations    Registration[]
  studentGuardians StudentGuardian[]

  @@index([phoneE164])
  @@map("guardians")
}

model Registration {
  id               String             @id @default(uuid()) @db.Char(36)
  registrationCode String             @unique @map("registration_code") @db.VarChar(64)
  childName        String             @map("child_name") @db.VarChar(191)
  birthDate        DateTime           @map("birth_date") @db.Date
  religion         String?            @db.VarChar(100)
  gender           String?            @db.VarChar(50)
  address          String             @db.Text
  guardianId       String             @map("guardian_id") @db.Char(36)
  branchId         String             @map("branch_id") @db.Char(36)
  consultationAt   DateTime?          @map("consultation_at")
  notes            String?            @db.Text
  status           RegistrationStatus @default(submitted)
  submittedAt      DateTime           @default(now()) @map("submitted_at")
  reviewedAt       DateTime?          @map("reviewed_at")
  deletedAt        DateTime?          @map("deleted_at")
  deletionReason   String?            @map("deletion_reason") @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  guardian      Guardian                    @relation(fields: [guardianId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch        Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  consents      RegistrationConsent[]
  statusHistory RegistrationStatusHistory[]
  transactions  PaymentTransaction[]
  student       Student?

  @@index([branchId, status, createdAt])
  @@index([deletedAt])
  @@index([guardianId])
  @@map("registrations")
}

model RegistrationConsent {
  id             String      @id @default(uuid()) @db.Char(36)
  registrationId String      @map("registration_id") @db.Char(36)
  consentType    ConsentType @map("consent_type")
  policyVersion  String      @map("policy_version") @db.VarChar(64)
  granted        Boolean
  grantedAt      DateTime?   @map("granted_at")
  revokedAt      DateTime?   @map("revoked_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([registrationId, consentType])
  @@map("registration_consents")
}

model RegistrationStatusHistory {
  id             String              @id @default(uuid()) @db.Char(36)
  registrationId String              @map("registration_id") @db.Char(36)
  fromStatus     RegistrationStatus? @map("from_status")
  toStatus       RegistrationStatus  @map("to_status")
  reason         String?             @db.Text
  changedById    String?             @map("changed_by") @db.Char(36)
  changedAt      DateTime            @default(now()) @map("changed_at")

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedBy    User?        @relation("RegistrationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([registrationId, changedAt])
  @@map("registration_status_history")
}

model PaymentTransaction {
  id                String        @id @default(uuid()) @db.Char(36)
  registrationId    String        @map("registration_id") @db.Char(36)
  purpose           String        @default("registration") @db.VarChar(100)
  amountIdr         BigInt        @map("amount_idr")
  currency          String        @default("IDR") @db.Char(3)
  status            PaymentStatus @default(pending)
  provider          String        @default("manual_transfer") @db.VarChar(100)
  providerReference String?       @map("provider_reference") @db.VarChar(191)
  dueAt             DateTime?     @map("due_at")
  paidAt            DateTime?     @map("paid_at")
  verifiedById      String?       @map("verified_by") @db.Char(36)
  verifiedAt        DateTime?     @map("verified_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedBy   User?          @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  proofs       PaymentProof[]

  @@index([registrationId, status])
  @@index([providerReference])
  @@map("payment_transactions")
}

model PaymentProof {
  id                   String    @id @default(uuid()) @db.Char(36)
  paymentTransactionId String    @map("payment_transaction_id") @db.Char(36)
  mediaAssetId         String    @unique @map("media_asset_id") @db.Char(36)
  reviewStatus         String    @default("pending") @map("review_status") @db.VarChar(32)
  reviewedById         String?   @map("reviewed_by") @db.Char(36)
  reviewedAt           DateTime? @map("reviewed_at")
  rejectionReason      String?   @map("rejection_reason") @db.Text
  uploadedAt           DateTime  @default(now()) @map("uploaded_at")

  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mediaAsset         MediaAsset         @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy         User?              @relation("PaymentProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([paymentTransactionId, reviewStatus])
  @@map("payment_proofs")
}

model Student {
  id             String        @id @default(uuid()) @db.Char(36)
  registrationId String?       @unique @map("registration_id") @db.Char(36)
  branchId       String        @map("branch_id") @db.Char(36)
  fullName       String        @map("full_name") @db.VarChar(191)
  birthDate      DateTime?     @map("birth_date") @db.Date
  religion       String?       @db.VarChar(100)
  gender         String?       @db.VarChar(50)
  address        String?       @db.Text
  status         StudentStatus @default(active)
  enrolledAt     DateTime      @default(now()) @map("enrolled_at")
  graduatedAt    DateTime?     @map("graduated_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  registration      Registration?     @relation(fields: [registrationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch            Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guardians         StudentGuardian[]
  sppInvoices       SppInvoice[]
  uniformDeliveries UniformDelivery[]
  mediaConsents     MediaConsent[]

  @@index([branchId, status, fullName])
  @@map("students")
}

model StudentGuardian {
  studentId    String  @map("student_id") @db.Char(36)
  guardianId   String  @map("guardian_id") @db.Char(36)
  relationship String  @db.VarChar(100)
  isPrimary    Boolean @default(false) @map("is_primary")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

model SppInvoice {
  id        String        @id @default(uuid()) @db.Char(36)
  studentId String        @map("student_id") @db.Char(36)
  period    String        @db.VarChar(20)
  amountIdr BigInt        @map("amount_idr")
  dueAt     DateTime?     @map("due_at")
  status    InvoiceStatus @default(unpaid)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  student  Student      @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payments SppPayment[]

  @@unique([studentId, period])
  @@index([status, dueAt])
  @@map("spp_invoices")
}

model SppPayment {
  id           String   @id @default(uuid()) @db.Char(36)
  invoiceId    String   @map("invoice_id") @db.Char(36)
  amountIdr    BigInt   @map("amount_idr")
  paidAt       DateTime @map("paid_at")
  method       String   @db.VarChar(100)
  reference    String?  @db.VarChar(191)
  recordedById String?  @map("recorded_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  invoice    SppInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedBy User?      @relation("SppPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([invoiceId, paidAt])
  @@map("spp_payments")
}

model UniformDelivery {
  id           String   @id @default(uuid()) @db.Char(36)
  studentId    String   @map("student_id") @db.Char(36)
  item         String   @db.VarChar(191)
  quantity     Int      @default(1)
  deliveredAt  DateTime @default(now()) @map("delivered_at")
  recordedById String?  @map("recorded_by") @db.Char(36)
  notes        String?  @db.Text

  student    Student @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recordedBy User?   @relation("UniformRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([studentId, deliveredAt])
  @@map("uniform_deliveries")
}

model StaffMember {
  id                String            @id @default(uuid()) @db.Char(36)
  branchId          String?           @map("branch_id") @db.Char(36)
  name              String            @db.VarChar(191)
  roleTitle         String            @map("role_title") @db.VarChar(191)
  active            Boolean           @default(true)
  photoAssetId      String?           @unique @map("photo_asset_id") @db.Char(36)
  publicationStatus PublicationStatus @default(draft) @map("publication_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  photoAsset MediaAsset? @relation("StaffPhoto", fields: [photoAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([branchId, active, publicationStatus])
  @@map("staff_members")
}

model Event {
  id                String            @id @default(uuid()) @db.Char(36)
  branchId          String            @map("branch_id") @db.Char(36)
  title             String            @db.VarChar(191)
  category          String            @db.VarChar(100)
  description       String?           @db.Text
  eventDate         DateTime?         @map("event_date")
  publicationStatus PublicationStatus @default(draft) @map("publication_status")
  createdById       String?           @map("created_by") @db.Char(36)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User?        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  media     EventMedia[]

  @@index([branchId, publicationStatus, eventDate])
  @@map("events")
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Char(36)
  storageKey   String   @unique @map("storage_key") @db.VarChar(512)
  mimeType     String   @map("mime_type") @db.VarChar(191)
  sizeBytes    BigInt   @map("size_bytes")
  content      Bytes?   @db.LongBlob
  checksum     String?  @db.VarChar(191)
  uploadedById String?  @map("uploaded_by") @db.Char(36)
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy   User?          @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  paymentProof PaymentProof?
  staffPhoto   StaffMember?   @relation("StaffPhoto")
  eventMedia   EventMedia[]
  consents     MediaConsent[]

  @@map("media_assets")
}

model EventMedia {
  eventId      String @map("event_id") @db.Char(36)
  mediaAssetId String @map("media_asset_id") @db.Char(36)
  sortOrder    Int    @default(0) @map("sort_order")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([eventId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("event_media")
}

model MediaConsent {
  id            String      @id @default(uuid()) @db.Char(36)
  mediaAssetId  String      @map("media_asset_id") @db.Char(36)
  studentId     String?     @map("student_id") @db.Char(36)
  consentType   ConsentType @map("consent_type")
  policyVersion String      @map("policy_version") @db.VarChar(64)
  granted       Boolean
  grantedAt     DateTime?   @map("granted_at")
  revokedAt     DateTime?   @map("revoked_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student    Student?   @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([mediaAssetId, consentType, granted])
  @@index([studentId])
  @@map("media_consents")
}

model Message {
  id          String        @id @default(uuid()) @db.Char(36)
  name        String        @db.VarChar(191)
  contact     String        @db.VarChar(191)
  category    String        @db.VarChar(100)
  branchId    String?       @map("branch_id") @db.Char(36)
  body        String        @db.Text
  status      MessageStatus @default(new)
  createdAt   DateTime      @default(now()) @map("created_at")
  handledById String?       @map("handled_by") @db.Char(36)
  handledAt   DateTime?     @map("handled_at")

  branch    Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  handledBy User?   @relation("MessageHandledBy", fields: [handledById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([branchId, status])
  @@map("messages")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Char(36)
  actorUserId String?  @map("actor_user_id") @db.Char(36)
  branchId    String?  @map("branch_id") @db.Char(36)
  action      String   @db.VarChar(191)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(191)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor  User?   @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([branchId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
}

model AppSetting {
  key         String   @id @db.VarChar(191)
  value       Json     @map("value_json")
  updatedById String?  @map("updated_by") @db.Char(36)
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("app_settings")
}

model Session {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  id        String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Char(36)
  scope          String            @db.VarChar(191)
  key            String            @db.VarChar(191)
  fingerprint    String            @db.Char(64)
  status         IdempotencyStatus @default(in_progress)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
