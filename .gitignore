/generated/prisma/
/src/generated/prisma/

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Logs, diagnostics, and temporary runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.tsbuildinfo
*.pid
*.pid.lock
*.seed
.eslintcache

